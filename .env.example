NODE_ENV=development
PORT=4000

MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/washora_db?retryWrites=true&w=majority

JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS_ORIGIN: Comma-separated allowed frontend origins
# Production: https://washora.vercel.app,https://washora-admin.vercel.app
# Local: http://localhost:3000,http://localhost:3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Production Hostinger API URL reference: https://deeppink-ibis-194201.hostingersite.com
